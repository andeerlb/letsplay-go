{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DEV",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/cmd/cyclolab/main.go",
      "env": {
        "APP_ENV": "dev",
        "CYCLOLAB_JWT_SECRET": "${env.CYCLOLAB_JWT_SECRET}",
        "CYCLOLAB_JWT_ADMIN_TOKEN": "${env.CYCLOLAB_JWT_ADMIN_TOKEN}",
        "GIN_MODE": "debug"
      }
    },
    {
      "name": "QA",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/cmd/cyclolab/main.go",
      "env": {
        "APP_ENV": "qa",
        "CYCLOLAB_JWT_SECRET": "${env.CYCLOLAB_JWT_SECRET}",
        "CYCLOLAB_JWT_ADMIN_TOKEN": "${env.CYCLOLAB_JWT_ADMIN_TOKEN}",
        "GIN_MODE": "debug"
      }
    }
  ]
}
